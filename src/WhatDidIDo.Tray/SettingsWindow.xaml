<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WhatDidIDo.Tray.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="whatdidido settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <!-- A row in the Windows 11 Settings style: glyph, title over description, control. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
            </Style>
            <Style x:Key="SectionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="4,20,0,6" />
            </Style>
            <Style x:Key="DescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <!-- Title bar (the content extends into it) -->
        <Grid x:Name="TitleBar" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Width="16" Height="16">
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/whatdidido.svg" RasterizePixelWidth="32" RasterizePixelHeight="32" />
                    </Image.Source>
                </Image>
                <TextBlock Text="whatdidido settings" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="32,0,32,32">
            <StackPanel MaxWidth="900" Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="4,8,0,4" />

                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource SectionStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" FontSize="20" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Start at login" />
                            <TextBlock x:Name="StartAtLoginDescription" Style="{StaticResource DescriptionStyle}"
                                       Text="Start the tray when you sign in to Windows" />
                        </StackPanel>
                        <ToggleSwitch VerticalAlignment="Center" x:Name="StartAtLoginSwitch" Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0"
                                      AutomationProperties.Name="Start at login" Toggled="StartAtLoginSwitch_Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE720;" FontSize="20" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Show microphone indicator" />
                            <TextBlock Style="{StaticResource DescriptionStyle}"
                                       Text="A microphone badge on the tray icon while the microphone is on" />
                        </StackPanel>
                        <ToggleSwitch VerticalAlignment="Center" x:Name="MicIndicatorSwitch" Grid.Column="2" OnContent="On" OffContent="Off" MinWidth="0"
                                      AutomationProperties.Name="Show microphone indicator" Toggled="MicIndicatorSwitch_Toggled" />
                    </Grid>
                </Border>

                <!-- Polling -->
                <TextBlock Text="Polling" Style="{StaticResource SectionStyle}" />
                <TextBlock Text="The status is also refreshed whenever the flyout opens." Style="{StaticResource DescriptionStyle}" Margin="4,0,0,4" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE916;" FontSize="20" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="While active (seconds)" />
                            <TextBlock Style="{StaticResource DescriptionStyle}"
                                       Text="Flyout open, or starting, recording, reconnecting or stopping" />
                        </StackPanel>
                        <NumberBox VerticalAlignment="Center" x:Name="PollActiveBox" Grid.Column="2" Width="140" SpinButtonPlacementMode="Inline"
                                   SmallChange="1" LargeChange="5" AutomationProperties.Name="Poll while active, seconds"
                                   ValueChanged="NumberBox_ValueChanged" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE823;" FontSize="20" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="While idle (seconds)" />
                            <TextBlock Style="{StaticResource DescriptionStyle}" Text="Stopped, paused, failed or not running" />
                        </StackPanel>
                        <NumberBox VerticalAlignment="Center" x:Name="PollIdleBox" Grid.Column="2" Width="140" SpinButtonPlacementMode="Inline"
                                   SmallChange="5" LargeChange="60" AutomationProperties.Name="Poll while idle, seconds"
                                   ValueChanged="NumberBox_ValueChanged" />
                    </Grid>
                </Border>

                <!-- Reminders -->
                <TextBlock Text="Reminders" Style="{StaticResource SectionStyle}" />
                <TextBlock Text="Counted from when the tray first saw the pause, or the microphone on without speech."
                           Style="{StaticResource DescriptionStyle}" Margin="4,0,0,4" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE769;" FontSize="20" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Remind while paused (minutes)" />
                            <TextBlock Style="{StaticResource DescriptionStyle}"
                                       Text="A notification after this long paused, then again every this many minutes; 0 = off" />
                        </StackPanel>
                        <NumberBox VerticalAlignment="Center" x:Name="PauseReminderBox" Grid.Column="2" Width="140" SpinButtonPlacementMode="Inline"
                                   SmallChange="1" LargeChange="10" AutomationProperties.Name="Remind while paused, minutes"
                                   ValueChanged="NumberBox_ValueChanged" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE720;" FontSize="20" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Remind to check the microphone after (minutes)" />
                            <TextBlock Style="{StaticResource DescriptionStyle}"
                                       Text="A notification when the microphone is on but no speech was transcribed for this long, then again every this many minutes; 0 = never" />
                        </StackPanel>
                        <NumberBox VerticalAlignment="Center" x:Name="MicReminderBox" Grid.Column="2" Width="140" SpinButtonPlacementMode="Inline"
                                   SmallChange="1" LargeChange="10" AutomationProperties.Name="Remind to check the microphone after, minutes"
                                   ValueChanged="NumberBox_ValueChanged" />
                    </Grid>
                </Border>

                <!-- Microphone -->
                <TextBlock Text="Microphone" Style="{StaticResource SectionStyle}" />
                <TextBlock Text="Choose the microphone in the flyout's Input list. Only that microphone is ever turned on; if it is not connected the microphone stays off."
                           Style="{StaticResource DescriptionStyle}" Margin="4,0,0,4" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE1D6;" FontSize="20" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Chosen microphone" />
                            <TextBlock x:Name="ChosenMicText" Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                        <Button VerticalAlignment="Center" x:Name="ForgetMicButton" Grid.Column="2" Content="Forget microphone" Click="ForgetMicButton_Click" />
                    </Grid>
                </Border>

                <!-- App server -->
                <TextBlock Text="App server" Style="{StaticResource SectionStyle}" />
                <TextBlock Text="Leave empty to find it automatically from the work session. Otherwise only a local address works: http://127.0.0.1:&lt;port&gt;."
                           Style="{StaticResource DescriptionStyle}" Margin="4,0,0,4" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center" />
                        <TextBox x:Name="AppUrlBox" Grid.Column="1" PlaceholderText="Automatic" VerticalAlignment="Center"
                                 AutomationProperties.Name="App server URL" KeyDown="AppUrlBox_KeyDown" TextChanged="AppUrlBox_TextChanged" />
                        <Button x:Name="AppUrlApply" Grid.Column="2" Content="Apply" Style="{StaticResource AccentButtonStyle}"
                                Click="AppUrlApply_Click" />
                        <TextBlock x:Name="AppUrlStatus" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource DescriptionStyle}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
